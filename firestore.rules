rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 組數、每組上限、信箱網域有改時，記得同步修改 event-config.js
    function groupCapacity() { return 8; }

    function validGroup(groupId) {
      return groupId in [
        'group-1', 'group-2', 'group-3', 'group-4',
        'group-5', 'group-6', 'group-7', 'group-8'
      ];
    }

    function companyEmail(email) {
      // 公司正在換信箱，@gis.fcu.edu.tw 和 @easymap.tw 都可以報名
      return email is string && email.matches('^[a-z0-9._-]+@(gis[.]fcu[.]edu[.]tw|easymap[.]tw)$');
    }

    function validReason(reasonType) {
      return reasonType in ['公假', '出差', '請假', '客戶會議或外部行程', '其他'];
    }

    // 報名截止：2026-11-26 00:00（台灣時間）起，同仁不能再改，只有管理員可以調整。
    // 改時間時，event-config.js 的 lockAt 也要一起改。
    function isOpen() { return request.time < timestamp.value(1795622400000); }

    function isSignedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }

    function isAdmin() {
      return isSignedIn() && myEmail() in [
        'yoyoshen@gis.fcu.edu.tw',
        'irishuang@gis.fcu.edu.tw',
        'clarachou@gis.fcu.edu.tw',
        'aaronhsu@gis.fcu.edu.tw'
      ];
    }

    function joinPath(email) { return /databases/$(database)/documents/picnicJoins/$(email); }
    function absencePath(email) { return /databases/$(database)/documents/picnicAbsences/$(email); }
    function groupPath(groupId) { return /databases/$(database)/documents/picnicGroups/$(groupId); }

    function isMemberOf(groupId) {
      return exists(joinPath(myEmail())) && get(joinPath(myEmail())).data.groupId == groupId;
    }

    // ---- 各組人數與隊名 ----

    function validGroupDoc(groupId) {
      let d = request.resource.data;
      return validGroup(groupId) &&
        d.keys().hasOnly(['count', 'teamName', 'teamNameBy', 'lastChange']) &&
        d.count is int &&
        d.count >= 0 &&
        d.count <= groupCapacity() &&
        (!('teamName' in d) || (d.teamName is string && d.teamName.size() <= 20));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 同一個 transaction 內有一個人加入這組，人數 +1
    function memberAdded(groupId) {
      let email = request.resource.data.lastChange;
      return changedOnly(['count', 'lastChange']) &&
        request.resource.data.count == resource.data.count + 1 &&
        !exists(joinPath(email)) &&
        existsAfter(joinPath(email)) &&
        getAfter(joinPath(email)).data.groupId == groupId;
    }

    // 同一個 transaction 內有一個人離開這組，人數 -1；最後一位離開時可清空隊名
    function memberRemoved(groupId) {
      let email = request.resource.data.lastChange;
      return (changedOnly(['count', 'lastChange']) ||
          (request.resource.data.count == 0 &&
            request.resource.data.teamName == '' &&
            request.resource.data.teamNameBy == '')) &&
        request.resource.data.count == resource.data.count - 1 &&
        exists(joinPath(email)) &&
        !existsAfter(joinPath(email)) &&
        get(joinPath(email)).data.groupId == groupId;
    }

    // 組員才能改自己組的隊名
    function memberRenames(groupId) {
      return changedOnly(['teamName', 'teamNameBy']) &&
        request.resource.data.teamNameBy == myEmail() &&
        isMemberOf(groupId);
    }

    match /picnicGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validGroupDoc(groupId);
      allow update: if isSignedIn() && validGroupDoc(groupId) &&
        (isAdmin() || (isOpen() && (memberAdded(groupId) || memberRemoved(groupId) || memberRenames(groupId))));
      allow delete: if false;
    }

    // ---- 選組資料（本人報名或隊長代報） ----

    match /picnicJoins/{email} {
      allow read: if isSignedIn();

      // 本人可以報名自己；已在組裡的人可以把隊友加進同一組；管理員可以把任何人加進任何一組
      allow create: if isSignedIn() &&
        companyEmail(email) &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'groupId', 'addedBy', 'addedByName', 'createdAt']) &&
        request.resource.data.email == email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 30 &&
        request.resource.data.addedBy == myEmail() &&
        request.resource.data.addedByName is string &&
        validGroup(request.resource.data.groupId) &&
        ((isAdmin() && !existsAfter(absencePath(email))) ||
          (isOpen() &&
            (email == myEmail() || isMemberOf(request.resource.data.groupId)) &&
            !exists(absencePath(email)))) &&
        // 每次只能加一個人：組別的 lastChange 必須是這筆資料本身
        getAfter(groupPath(request.resource.data.groupId)).data.lastChange == email &&
        getAfter(groupPath(request.resource.data.groupId)).data.count ==
          get(groupPath(request.resource.data.groupId)).data.count + 1;

      // 被代報的人第一次登入時，把名單上的帳號換成本人的名字
      allow update: if isSignedIn() && email == myEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 30;

      // 管理員把人換到別組（人數在同一個 transaction 裡由管理員一起更新）
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId']) &&
        validGroup(request.resource.data.groupId);

      // 本人退出、代報的人移除自己加的隊友、管理員刪除
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isOpen() &&
          (email == myEmail() || resource.data.addedBy == myEmail()) &&
          getAfter(groupPath(resource.data.groupId)).data.lastChange == email &&
          getAfter(groupPath(resource.data.groupId)).data.count ==
            get(groupPath(resource.data.groupId)).data.count - 1)
      );
    }

    // ---- 不能參加的回報（只有本人與管理員看得到） ----

    match /picnicAbsences/{email} {
      allow read: if isSignedIn() && (email == myEmail() || isAdmin());
      // 本人在截止前回報；管理員隨時可以幫人登記（會在同一個 transaction 裡把他移出組別）
      allow create, update: if isSignedIn() &&
        companyEmail(email) &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'reasonType', 'reasonNote', 'createdAt', 'updatedAt']) &&
        request.resource.data.email == email &&
        request.resource.data.displayName is string &&
        validReason(request.resource.data.reasonType) &&
        request.resource.data.reasonNote is string &&
        request.resource.data.reasonNote.size() <= 200 &&
        ((isAdmin() && !existsAfter(joinPath(email))) ||
          (isOpen() && email == myEmail() && !exists(joinPath(email))));
      allow delete: if isSignedIn() && (isAdmin() || (isOpen() && email == myEmail()));
    }
  }
}
